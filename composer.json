{
    "name": "kadegray/statamic-phone-number-fieldtype",
    "description": "Statamic Phone Number Fieldtype Addon",
    "authors": [
        {
            "name": "Kade Gray"
        }
    ],
    "autoload": {
        "psr-4": {
            "Kadegray\\StatamicPhoneNumberFieldtype\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kadegray\\StatamicPhoneNumberFieldtype\\Tests\\": "tests",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Phone Number Fieldtype",
            "description": "Statamic Phone Number Fieldtype is a Statamic addon that is everything you need to store and display Phone Numbers on your site."
        },
        "laravel": {
            "providers": [
                "Kadegray\\StatamicPhoneNumberFieldtype\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "require": {
        "sokil/php-isocodes": "^4.1",
        "sokil/php-isocodes-db-i18n": "^4.0",
        "giggsey/libphonenumber-for-php": "^8.13",
        "statamic/cms": "^6.0",
        "symfony/translation": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "pre-update-cmd": [
            "Statamic\\Console\\Composer\\Scripts::preUpdateCmd"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/phpunit"
        ]
    }
}
